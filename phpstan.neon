includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 5

    paths:
        - phpseclib
        - tests

    phpVersion: 80200

    reportUnmatchedIgnoredErrors: true
    checkMissingOverrideMethodAttribute: false

    ignoreErrors:
        -
            identifier: property.onlyWritten
            rawMessage: 'Property phpseclib4\File\ANSI::$old_x is never read, only written.'
            path: phpseclib/File/ANSI.php
            count: 1 

        # R3: outer ContentInfo survives offset access before return (Constructed).
        # Inner blob hazards stay reported; see analysis/phpstan-asn1-r3-guarded-return-policy.md.
        -
            identifier: return.type
            rawMessage: 'Method phpseclib4\File\CMS\CompressedData::loadString() should return phpseclib4\File\ASN1\Constructed but returns (ArrayAccess&phpseclib4\File\ASN1\Element)|(ArrayAccess&phpseclib4\File\ASN1\Types\BaseType).'
            path: phpseclib/File/CMS/CompressedData.php
            count: 1
        -
            identifier: return.type
            rawMessage: 'Method phpseclib4\File\CMS\DigestedData::loadString() should return phpseclib4\File\ASN1\Constructed but returns (ArrayAccess&phpseclib4\File\ASN1\Element)|(ArrayAccess&phpseclib4\File\ASN1\Types\BaseType).'
            path: phpseclib/File/CMS/DigestedData.php
            count: 1
        -
            identifier: return.type
            rawMessage: 'Method phpseclib4\File\CMS\EncryptedData::loadString() should return phpseclib4\File\ASN1\Constructed but returns (ArrayAccess&phpseclib4\File\ASN1\Element)|(ArrayAccess&phpseclib4\File\ASN1\Types\BaseType).'
            path: phpseclib/File/CMS/EncryptedData.php
            count: 1
        -
            identifier: return.type
            rawMessage: 'Method phpseclib4\File\CMS\SignedData::loadString() should return phpseclib4\File\ASN1\Constructed but returns (ArrayAccess&phpseclib4\File\ASN1\Element)|(ArrayAccess&phpseclib4\File\ASN1\Types\BaseType).'
            path: phpseclib/File/CMS/SignedData.php
            count: 1

        # R3: outer PFX survives authSafe offset access; this does not validate inner contents.
        -
            identifier: return.type
            rawMessage: 'Method phpseclib4\File\PFX::loadString() should return phpseclib4\File\ASN1\Constructed but returns (ArrayAccess&phpseclib4\File\ASN1\Element)|(ArrayAccess&phpseclib4\File\ASN1\Types\BaseType).'
            path: phpseclib/File/PFX.php
            count: 1
        # R3: CertBag survives certId offset access before return (Constructed).
        -
            identifier: return.type
            rawMessage: 'Method phpseclib4\File\PFX::handleCertBag() should return phpseclib4\File\ASN1\Constructed but returns phpseclib4\File\ASN1\Element|phpseclib4\File\ASN1\Types\BaseType.'
            path: phpseclib/File/PFX.php
            count: 1

        # Late-static numeric reconstruction assumes compatible descendant construction.
        # Accepted constructor-checking difference: migration_remarks.md.
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/BigInteger.php
            count: 35
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/BigInteger/Engines/Engine.php
            count: 30
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/BigInteger/Engines/BCMath.php
            count: 13
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/BigInteger/Engines/GMP.php
            count: 1
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/BigInteger/Engines/PHP.php
            count: 22

        # Field arithmetic reconstructs the same class with its registered instance ID.
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/PrimeField/Integer.php
            count: 6
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Math/BinaryField/Integer.php
            count: 5

        # GCM fallback constructs same-algorithm CTR/ECB helper ciphers.
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/Crypt/Common/SymmetricKey.php
            count: 3
        # Recipient loading constructs an empty instance before hydrating its payload.
        -
            identifier: new.static
            rawMessage: 'Unsafe usage of new static().'
            path: phpseclib/File/CMS/EnvelopedData/Recipient.php
            count: 1
